contract RiffDBOpenFGA version 1 {
  enum TupleOperation { Write, Delete }

  entity Store {
    key (registry_id: uuid, store_id: string<26>)
    field name: string<64>
    field created_at: timestamp
    field updated_at: timestamp
    field deleted_at: optional<timestamp>
    field revision: u64
    index active_by_id (registry_id, deleted_at, store_id) presence(deleted_at)
    index active_by_name (registry_id, deleted_at, name, store_id) presence(deleted_at)
  }

  entity AuthorizationModel {
    key (store_id: string<26>, model_id: string<26>)
    field schema_version: string<5>
    field serialized_protobuf: bytes<262144>
    index by_store_model (store_id, model_id)
  }

  entity AssertionSet {
    key (store_id: string<26>, model_id: string<26>)
    field serialized_protobuf: bytes<64000>
    field revision: u64
  }

  entity TuplePartition {
    key (store_id: string<26>)
  }

  entity TupleState {
    key (
      store_id: string<26>,
      object_type: string<128>,
      object_id: string<256>,
      relation: string<50>,
      user: string<512>
    )
    field user_object_type: string<128>
    field user_object_id: string<256>
    field user_relation: string<50>
    field user_kind: string<7>
    field condition_key: string<256>
    field condition_context: optional<bytes<32768>>
    field inserted_at: timestamp
    field active: bool
    field revision: u64
    index all_active (
      store_id, active, object_type, object_id, relation, user
    ) text_key(object_type, binary_utf8_v1)
      text_key(object_id, binary_utf8_v1)
      text_key(relation, binary_utf8_v1)
      text_key(user, binary_utf8_v1)
    index by_object (
      store_id, active, object_type, object_id, relation, user
    ) text_key(relation, binary_utf8_v1)
      text_key(user, binary_utf8_v1)
    index by_type_relation (
      store_id, active, object_type, relation, object_id, user
    ) text_key(object_id, binary_utf8_v1)
      text_key(user, binary_utf8_v1)
    index by_type_user (
      store_id, active, object_type, user, object_id, relation
    ) text_key(object_id, binary_utf8_v1)
      text_key(relation, binary_utf8_v1)
    index by_object_user (
      store_id, active, object_type, object_id, user, relation
    ) text_key(relation, binary_utf8_v1)
    index by_user (
      store_id, active, user, object_type, object_id, relation
    ) text_key(object_type, binary_utf8_v1)
      text_key(object_id, binary_utf8_v1)
      text_key(relation, binary_utf8_v1)
    index by_relation_user (
      store_id, active, relation, user, object_type, object_id
    ) text_key(object_type, binary_utf8_v1)
      text_key(object_id, binary_utf8_v1)
    index by_condition_object (
      store_id, active, condition_key, object_type, object_id, relation, user
    ) text_key(relation, binary_utf8_v1)
      text_key(user, binary_utf8_v1)
    index by_condition_type_relation (
      store_id, active, condition_key, object_type, relation, object_id, user
    ) text_key(object_id, binary_utf8_v1)
      text_key(user, binary_utf8_v1)
    index by_condition_type_user (
      store_id, active, condition_key, object_type, user, object_id, relation
    ) text_key(object_id, binary_utf8_v1)
      text_key(relation, binary_utf8_v1)
    index by_condition_type_relation_user (
      store_id, active, condition_key, object_type, relation, user, object_id
    ) text_key(object_id, binary_utf8_v1)
    index by_condition_object_user (
      store_id, active, condition_key, object_type, object_id, user, relation
    ) text_key(relation, binary_utf8_v1)
    index by_condition_user (
      store_id, active, condition_key, user, object_type, object_id, relation
    ) text_key(object_type, binary_utf8_v1)
      text_key(object_id, binary_utf8_v1)
      text_key(relation, binary_utf8_v1)
    index by_condition_relation_user (
      store_id, active, condition_key, relation, user, object_type, object_id
    ) text_key(object_type, binary_utf8_v1)
      text_key(object_id, binary_utf8_v1)
    index reverse_by_user (
      store_id, active, object_type, relation, user, object_id
    ) text_key(object_id, binary_utf8_v1)
    index userset_by_type (
      store_id, active, object_type, object_id, relation,
      user_kind, user_object_type, user_relation, user
    ) text_key(user_object_type, binary_utf8_v1)
      text_key(user_relation, binary_utf8_v1)
      text_key(user, binary_utf8_v1)
    index userset_by_condition (
      store_id, active, condition_key, object_type, object_id, relation,
      user_kind, user_object_type, user_relation, user
    ) text_key(user_object_type, binary_utf8_v1)
      text_key(user_relation, binary_utf8_v1)
      text_key(user, binary_utf8_v1)
    index reverse_by_condition (
      store_id, active, condition_key, object_type, relation, user, object_id
    ) text_key(object_id, binary_utf8_v1)
  }

  entity TupleChange {
    key (store_id: string<26>, change_id: string<26>)
    field object_type: string<128>
    field object_id: string<256>
    field relation: string<50>
    field user: string<512>
    field operation: TupleOperation
    field condition_key: string<256>
    field condition_context: optional<bytes<32768>>
    field inserted_at: timestamp
    index by_store_change (store_id, inserted_at, change_id)
      text_key(change_id, binary_utf8_v1)
    index by_store_object_change (store_id, object_type, inserted_at, change_id)
      text_key(change_id, binary_utf8_v1)
  }

  entity TupleMutationInput {
    key (store_id: string<26>, change_id: string<26>)
    field object_type: string<128>
    field object_id: string<256>
    field relation: string<50>
    field user: string<512>
    field user_object_type: string<128>
    field user_object_id: string<256>
    field user_relation: string<50>
    field user_kind: string<7>
    field operation: TupleOperation
    field condition_key: string<256>
    field condition_context: optional<bytes<32768>>
    field inserted_at: timestamp
    field expected_active: bool
    field next_active: bool
    field expected_revision: u64
  }

  aggregate Stores {
    root Store
    partition_by registry_id
    conflict_key (registry_id, store_id)
  }

  aggregate Models {
    root AuthorizationModel
    partition_by store_id
    conflict_key (store_id)
  }

  aggregate Assertions {
    root AssertionSet
    partition_by store_id
    conflict_key (store_id)
  }

  aggregate Tuples {
    root TuplePartition
    child TupleState
    child TupleChange
    child TupleMutationInput
    partition_by store_id
    conflict_key (store_id)
  }

  command CreateStore {
    input request_id: uuid
    input registry_id: uuid
    input store_id: string<26>
    input name: string<64>
    service created_at: transaction_time
    idempotency_key request_id
    create Store(registry_id, store_id) as store else StoreAlreadyExists {}
    set store.name = name
    set store.created_at = created_at
    set store.updated_at = created_at
    set store.deleted_at = null
    set store.revision = 1
    return StoreCreated { store: store }
  }

  command DeleteStore {
    input request_id: uuid
    input registry_id: uuid
    input store_id: string<26>
    input expected_revision: u64
    service deleted_at: transaction_time
    idempotency_key request_id
    mutate Store(registry_id, store_id) as store else StoreMissing {}
    require store_active: store.deleted_at == null else StoreMissing {}
    require store_revision: store.revision == expected_revision else StoreChanged {}
    set store.deleted_at = deleted_at
    set store.updated_at = deleted_at
    set store.revision = store.revision + 1
    return StoreDeleted {}
  }

  command WriteAuthorizationModel {
    input request_id: uuid
    input store_id: string<26>
    input model_id: string<26>
    input schema_version: string<5>
    input serialized_protobuf: bytes<262144>
    idempotency_key request_id
    create AuthorizationModel(store_id, model_id) as model else ModelAlreadyExists {}
    set model.schema_version = schema_version
    set model.serialized_protobuf = serialized_protobuf
    return ModelWritten {}
  }

  command CreateAssertionSet {
    input request_id: uuid
    input store_id: string<26>
    input model_id: string<26>
    input serialized_protobuf: bytes<64000>
    idempotency_key request_id
    create AssertionSet(store_id, model_id) as assertions else AssertionSetAlreadyExists {}
    set assertions.serialized_protobuf = serialized_protobuf
    set assertions.revision = 1
    return AssertionSetCreated {}
  }

  command EnsureTuplePartition {
    input request_id: uuid
    input store_id: string<26>
    idempotency_key request_id
    create TuplePartition(store_id) as partition else TuplePartitionAlreadyExists {}
    return TuplePartitionEnsured {}
  }

  command UpdateAssertionSet {
    input request_id: uuid
    input store_id: string<26>
    input model_id: string<26>
    input expected_revision: u64
    input serialized_protobuf: bytes<64000>
    idempotency_key request_id
    mutate AssertionSet(store_id, model_id) as assertions else AssertionSetMissing {}
    require assertion_revision: assertions.revision == expected_revision else AssertionSetChanged {}
    set assertions.serialized_protobuf = serialized_protobuf
    set assertions.revision = assertions.revision + 1
    return AssertionSetUpdated {}
  }

  bulk command EnsureTupleStates {
    input request_id: uuid
    input states: list<TupleState, 1..100> aggregate_bytes <= 900000
    idempotency_key request_id
    for state_input in states {
      create TupleState(
        state_input.store_id,
        state_input.object_type,
        state_input.object_id,
        state_input.relation,
        state_input.user
      ) as state else TupleStateAlreadyExists {}
      set state.user_object_type = state_input.user_object_type
      set state.user_object_id = state_input.user_object_id
      set state.user_relation = state_input.user_relation
      set state.user_kind = state_input.user_kind
      set state.condition_key = state_input.condition_key
      set state.condition_context = state_input.condition_context
      set state.inserted_at = state_input.inserted_at
      set state.active = state_input.active
      set state.revision = state_input.revision
    }
    return TupleStatesEnsured {}
  }

  bulk command ApplyTupleMutations {
    input request_id: uuid
    input mutations: list<TupleMutationInput, 1..100> aggregate_bytes <= 900000
    idempotency_key request_id
    for mutation in mutations {
      mutate TupleState(
        mutation.store_id,
        mutation.object_type,
        mutation.object_id,
        mutation.relation,
        mutation.user
      ) as state else TupleStateMissing {}
      create TupleChange(mutation.store_id, mutation.change_id) as change
        else TupleChangeAlreadyExists {}
      require tuple_revision: state.revision == mutation.expected_revision
        else TupleStateChanged {}
      require tuple_activity: state.active == mutation.expected_active
        else TupleStateChanged {}
      set state.user_object_type = mutation.user_object_type
      set state.user_object_id = mutation.user_object_id
      set state.user_relation = mutation.user_relation
      set state.user_kind = mutation.user_kind
      set state.condition_key = mutation.condition_key
      set state.condition_context = mutation.condition_context
      set state.inserted_at = mutation.inserted_at
      set state.active = mutation.next_active
      set state.revision = state.revision + 1
      set change.object_type = mutation.object_type
      set change.object_id = mutation.object_id
      set change.relation = mutation.relation
      set change.user = mutation.user
      set change.operation = mutation.operation
      set change.condition_key = mutation.condition_key
      set change.condition_context = mutation.condition_context
      set change.inserted_at = mutation.inserted_at
    }
    return TupleMutationsApplied {}
  }
}
