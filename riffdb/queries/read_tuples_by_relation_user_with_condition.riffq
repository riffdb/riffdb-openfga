query ReadTuplesByRelationUserWithCondition(
    $store_id: TupleState.store_id,
    $relation: TupleState.relation,
    $user: TupleState.user,
    $condition: TupleState.condition_key,
    $limit: Limit<50> = 50,
    $after: Cursor?,
) {
    many tuples from TupleState
        where store_id == $store_id && active == true && condition_key == $condition && relation == $relation && user == $user
        order by object_type asc, object_id asc
        take $limit after $after
    return Found { tuples: tuples { object_type object_id relation user condition_key condition_context inserted_at } }
    outcomes Found
}
