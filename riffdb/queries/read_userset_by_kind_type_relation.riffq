query ReadUsersetByKindTypeRelation(
    $store_id: TupleState.store_id, $object_type: TupleState.object_type,
    $object_id: TupleState.object_id, $relation: TupleState.relation,
    $user_kind: TupleState.user_kind, $user_object_type: TupleState.user_object_type,
    $user_relation: TupleState.user_relation, $limit: Limit<50> = 50, $after: Cursor?,
) {
    many tuples from TupleState
        where store_id == $store_id && active == true
          && object_type == $object_type && object_id == $object_id
          && relation == $relation && user_kind == $user_kind
          && user_object_type == $user_object_type && user_relation == $user_relation
        order by user asc
        take $limit after $after
    return Found { tuples: tuples {
        store_id object_type object_id relation user user_object_type user_object_id
        user_relation user_kind condition_key condition_context inserted_at active revision
    } }
    outcomes Found
}

