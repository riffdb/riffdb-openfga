query ListAuthorizationModels(
    $store_id: AuthorizationModel.store_id,
    $limit: Limit<15> = 15,
    $after: Cursor?,
) {
    many models from AuthorizationModel
        where store_id == $store_id
        order by model_id desc
        take $limit after $after

    return Found {
        models: models { store_id model_id schema_version serialized_protobuf }
    }
    outcomes Found
}
