query GetTupleState(
    $store_id: TupleState.store_id,
    $object_type: TupleState.object_type,
    $object_id: TupleState.object_id,
    $relation: TupleState.relation,
    $user: TupleState.user,
) {
    one state from TupleState
        where store_id == $store_id
          && object_type == $object_type
          && object_id == $object_id
          && relation == $relation
          && user == $user
        else NotFound

    return Found {
        state: state {
            store_id object_type object_id relation user
            user_object_type user_object_id user_relation user_kind
            condition_key condition_context inserted_at active revision
        }
    }
    outcomes Found | NotFound
}
