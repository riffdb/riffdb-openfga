query ReadChangesAsc(
    $store_id: TupleChange.store_id,
    $start: TupleChange.inserted_at?,
    $horizon: TupleChange.inserted_at,
    $limit: Limit<50> = 50,
    $after: Cursor?,
) {
    many changes from TupleChange
        where store_id == $store_id
          && when $start { inserted_at > $start }
          && inserted_at < $horizon
        order by inserted_at asc, change_id asc
        take $limit after $after

    return Found {
        changes: changes {
            store_id change_id object_type object_id relation user operation
            condition_key condition_context inserted_at
        }
    }
    outcomes Found
}
