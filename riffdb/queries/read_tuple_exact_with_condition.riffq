query ReadTupleExactWithCondition(
    $store_id: TupleState.store_id,
    $object_type: TupleState.object_type,
    $object_id: TupleState.object_id,
    $relation: TupleState.relation,
    $user: TupleState.user,
    $condition: TupleState.condition_key,
) {
    one tuple from TupleState
        where store_id == $store_id && active == true
          && condition_key == $condition && object_type == $object_type
          && object_id == $object_id && relation == $relation && user == $user
        else NotFound
    return Found { tuple: tuple {
        object_type object_id relation user condition_key condition_context inserted_at
    } }
    outcomes Found | NotFound
}

